{
  "name": "clubos",
  "version": "0.1.0",
  "private": true,
  "description": "ClubOS - Plataforma SaaS modular multi-tenant para gestao de organizacoes (clubes, academias, associacoes).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @clubos/database generate",
    "db:migrate": "pnpm --filter @clubos/database migrate",
    "db:deploy": "pnpm --filter @clubos/database run migrate:deploy",
    "db:push": "pnpm --filter @clubos/database push",
    "db:seed": "pnpm --filter @clubos/database seed && pnpm --filter @clubos/api seed:users",
    "db:studio": "pnpm --filter @clubos/database studio",
    "docker:up": "docker compose --profile local up -d",
    "docker:down": "docker compose --profile local down",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "db:backup": "node scripts/run-backup.mjs",
    "db:restore": "node scripts/run-backup.mjs restore",
    "mobile": "pnpm --filter @clubos/mobile start",
    "mobile:android": "pnpm --filter @clubos/mobile android",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "turbo": "^2.10.11",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "next": "16.3.6",
      "multer": "2.3.0",
      "nodemailer": "10.0.6",
      "nanoid@3": "3.3.18",
      "js-yaml": "4.3.2",
      "postcss": "8.5.18",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.7",
      "ip-address": "10.3.1",
      "sharp": "0.35.4",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@5": "5.0.12",
      "deepmerge-ts": "8.0.0",
      "tinypool": "2.2.0"
    }
  }
}
