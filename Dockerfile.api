FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
ENV HUSKY=0

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
# Hoist para o runner resolver dependencias sem symlinks pnpm partidos.
RUN echo "shamefully-hoist=true" >> .npmrc \
  && pnpm install --frozen-lockfile --filter @clubos/api...

FROM deps AS build
COPY apps/api ./apps/api
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared
COPY scripts/docker-api-entrypoint.sh ./scripts/docker-api-entrypoint.sh
RUN pnpm db:generate
RUN pnpm --filter @clubos/database build
RUN pnpm --filter @clubos/shared build
RUN pnpm --filter @clubos/api build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HUSKY=0
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/.npmrc ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/packages/database ./packages/database
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/scripts/docker-api-entrypoint.sh /docker-api-entrypoint.sh
RUN chmod +x /docker-api-entrypoint.sh

WORKDIR /app/apps/api
EXPOSE 4000
ENTRYPOINT ["/docker-api-entrypoint.sh"]
