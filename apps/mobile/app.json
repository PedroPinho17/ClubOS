{
  "expo": {
    "name": "ClubOS",
    "slug": "clubos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clubos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.clubos.app",
      "infoPlist": {
        "NSCameraUsageDescription": "A camara e usada para ler o QR do cartao de socio.",
        "NSFaceIDUsageDescription": "Desbloquear a app com biometria."
      }
    },
    "android": {
      "package": "pt.clubos.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "RECEIVE_BOOT_COMPLETED", "VIBRATE"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A5F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso a camara para ler o QR do socio."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E3A5F"
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9025d813-cb75-4930-93f9-4e3ea328909b"
      },
      "apiUrl": "http://localhost:4000"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9025d813-cb75-4930-93f9-4e3ea328909b"
    }
  }
}
